# One .env at the repo root, read by every service in development.
# Production sets the same names in the deployment's environment.
# An empty value means "unset".

NODE_ENV=development

# Ports: a band of its own, so several projects and worktrees run side by side.
API_PORT=4690
CLIENT_PORT=4691
PREVIEW_PORT=4692
POSTGRES_PORT=4693

DATABASE_URL=postgresql://brain:brain@localhost:4693/brain

# Public URL of the app (the client's origin; /api is routed beside it).
APP_URL=http://localhost:4691
# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-in: a GitHub OAuth app (callback <APP_URL>/api/auth/callback/github),
# and the one GitHub account let in, by numeric id (gh api user --jq .id).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_ID=

# The vault: owner/name, branch, and a fine-grained token with Contents read
# and write on that repo only. Unset: the tools answer "not configured".
VAULT_REPO=Dr-Wade/vault
VAULT_BRANCH=main
VAULT_TOKEN=
VAULT_TIMEZONE=Europe/Paris

# Optional: repos the file_for_atlas tool may open issues on (comma-separated
# owner/name) and a token with Issues read and write on them.
ISSUE_REPOS=
ISSUE_TOKEN=

# Optional. Unset means the integration does nothing.
SENTRY_DSN=
# Browser DSN, handed to the client by GET /api/config.
SENTRY_CLIENT_DSN=
LOG_LEVEL=
