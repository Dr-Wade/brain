{
    "name": "@brain/database",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "prisma",
        "prisma.config.ts"
    ],
    "scripts": {
        "build": "prisma generate && tsc -p tsconfig.json",
        "dev": "prisma generate && tsc -p tsconfig.json --watch --preserveWatchOutput",
        "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
        "generate": "prisma generate",
        "migrate:dev": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "migrate:reset": "prisma migrate reset --force",
        "migration:create": "sh -c 'set -e; dir=prisma/migrations/$(date -u +%Y%m%d%H%M%S)_${1:?usage: migration:create <name>}; mkdir -p \"$dir\"; prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script -o \"$dir/migration.sql\"; if grep -q \"empty migration\" \"$dir/migration.sql\"; then rm -r \"$dir\"; echo \"The schema matches the database: no migration.\"; else echo \"$dir/migration.sql\"; fi' --"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "prisma": "^7.10.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}
