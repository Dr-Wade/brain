{
    "name": "brain",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "pnpm build:packages && pnpm -r --parallel dev",
        "dev:api": "pnpm --filter @brain/api dev",
        "dev:client": "pnpm --filter @brain/client dev",
        "build": "pnpm -r build",
        "build:packages": "pnpm -r --filter \"./packages/**\" build",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint --max-warnings 0 .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "check": "pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down",
        "db:migrate": "pnpm --filter @brain/database migrate:dev",
        "db:migration": "pnpm --filter @brain/database migration:create",
        "db:deploy": "pnpm --filter @brain/database migrate:deploy",
        "db:reset": "pnpm --filter @brain/database migrate:reset",
        "openapi": "pnpm --filter @brain/api openapi:export && pnpm --filter @brain/client openapi:generate"
    },
    "devDependencies": {
        "@drwade/eslint-config": "^2.0.0",
        "@playwright/test": "^1.64.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0",
        "vue-eslint-parser": "^10.4.1"
    }
}
