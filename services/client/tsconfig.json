{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "noEmit": true,
        "declaration": false,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "openapi-ts.config.ts"]
}
