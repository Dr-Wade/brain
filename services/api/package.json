{
    "name": "@brain/api",
    "private": true,
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "start": "node dist/main.js",
        "openapi:export": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/openapi-export.js"
    },
    "dependencies": {
        "@better-auth/mcp": "^1.7.19",
        "@better-auth/oauth-provider": "^1.7.19",
        "@brain/database": "workspace:*",
        "@brain/logger": "workspace:*",
        "@brain/schemas": "workspace:*",
        "@modelcontextprotocol/server": "^2.4.0",
        "@nestjs/common": "^12.3.0",
        "@nestjs/core": "^12.3.0",
        "@nestjs/platform-express": "^12.3.0",
        "@nestjs/swagger": "^12.1.0",
        "@sentry/nestjs": "^11.10.0",
        "@thallesp/nestjs-better-auth": "^2.8.0",
        "better-auth": "^1.7.19",
        "express": "^5.3.0",
        "ical.js": "^2.2.1",
        "nanotar": "^0.3.0",
        "nestjs-pino": "^5.3.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "prisma": "^7.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@nestjs/testing": "^12.3.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}
